{
  "name": "hoshino-backend",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch ./src/index.ts",
    "build": "bun build ./src/index.ts --compile --minify --outfile ./dist/hoshino",
    "typecheck": "bun tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "latest",
    "@types/node-cache": "^4.2.5",
    "@types/pino": "^7.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@hapi/boom": "^10.0.1",
    "audio-decode": "^3.12.0",
    "baileys": "^7.0.0-rc14",
    "btch-downloader": "^6.3.6",
    "elysia": "^1.4.30",
    "ffmpeg": "^0.0.4",
    "jimp": "^1.6.1",
    "link-preview-js": "^5.0.0",
    "mathjs": "^15.2.0",
    "nekosapi": "^0.7.0",
    "node-cache": "^5.1.2",
    "node-webpmux": "^3.2.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.4",
    "youtube-dl-exec": "^3.1.13"
  },
  "trustedDependencies": [
    "youtube-dl-exec"
  ]
}
